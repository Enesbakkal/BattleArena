{
  "info": {
    "_postman_id": "b8e3a1c0-0000-4000-8000-battlearena-local",
    "name": "BattleArena — Local (5084)",
    "description": "Import into Postman. Start API: dotnet run --project BattleArena.Api --launch-profile http",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5084" },
    { "key": "characterId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Hangfire dashboard (browser)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/hangfire"
      }
    },
    {
      "name": "Characters — Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const raw = pm.response.text();",
              "  let id = raw.trim();",
              "  if (id.startsWith('\"') && id.endsWith('\"')) { id = id.slice(1, -1); }",
              "  pm.collectionVariables.set('characterId', id);",
              "  pm.test('Saved characterId to collection variable', function () { pm.expect(id).to.match(/^[0-9a-f-]{36}$/i); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Hero\",\n  \"universe\": \"TestVerse\",\n  \"biography\": \"From collection\",\n  \"rarity\": 2,\n  \"baseAttack\": 12,\n  \"baseDefense\": 10,\n  \"baseSpeed\": 9,\n  \"imageUrl\": null\n}"
        },
        "url": "{{baseUrl}}/api/characters"
      }
    },
    {
      "name": "Characters — Get by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/characters/{{characterId}}"
      }
    },
    {
      "name": "Characters — Paged list",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/characters?page=1&pageSize=20"
      }
    },
    {
      "name": "Characters — Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/characters/search?term=Postman&size=20"
      }
    },
    {
      "name": "Characters — Update",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Hero Updated\",\n  \"universe\": \"TestVerse\",\n  \"biography\": \"Updated via Postman\",\n  \"rarity\": 3,\n  \"baseAttack\": 15,\n  \"baseDefense\": 11,\n  \"baseSpeed\": 10,\n  \"imageUrl\": null\n}"
        },
        "url": "{{baseUrl}}/api/characters/{{characterId}}"
      }
    },
    {
      "name": "Characters — Delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/characters/{{characterId}}"
      }
    }
  ]
}
